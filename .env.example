# Copy to .env and fill in. Never commit .env. Values here must stay empty.
# LLM_PROVIDER: anthropic | gemini
LLM_PROVIDER=
# LLM_MODEL: empty uses the provider default (gemini: gemini-3.1-flash-lite)
LLM_MODEL=
LLM_API_KEY=
# Defaults when empty: sqlite:///./sentinel.db and 20000 bytes
DATABASE_URL=
MAX_SNIPPET_BYTES=
